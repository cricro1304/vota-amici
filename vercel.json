{
  "buildCommand": "bash build.sh",
  "outputDirectory": "dist",
  "installCommand": "echo skip",
  "framework": null,
  "redirects": [
    { "source": "/landing-page.html", "destination": "/", "statusCode": 301 },
    { "source": "/en/landing-page.html", "destination": "/en", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landing-page.html" },
    { "source": "/en", "destination": "/en/landing-page.html" },
    { "source": "/en/", "destination": "/en/landing-page.html" },
    { "source": "/packs", "destination": "/packs.html" },
    { "source": "/en/packs", "destination": "/en/packs.html" },
    { "source": "/play", "destination": "/play/index.html" },
    { "source": "/play/(.*)", "destination": "/play/index.html" },
    { "source": "/room/(.*)", "destination": "/play/index.html" }
  ]
}
